# 로컬: `pnpm exec supabase start` 실행 후 출력되는 값을 그대로 복사해 .env.local에 붙여넣는다.
# 클라우드: `pnpm exec supabase login` 후 프로젝트 생성/연결하면 값이 바뀐다.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Prisma (P0-3)
DATABASE_URL=
DIRECT_URL=

# Upstash Redis — 권한 TTL 캐시(NF-SEC-05, apps/web/src/lib/permission-cache.ts)
# Next.js 서버 전용(클라이언트 노출 금지). 미설정 시 캐시는 no-op, RLS/DB 직접 조회로 폴백.
# 값은 Upstash 콘솔의 REST API 섹션에서 복사. DB 트리거용 Vault 시크릿
# (redis_rest_url/redis_rest_token)은 별도로 마이그레이션 후 vault.create_secret 로 등록.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry — 옵저버빌리티(에러/성능 트레이싱). DSN 미설정 시 전송 no-op, 개발 환경은 항상 전송 안 함.
# 웹: Sentry 프로젝트 생성 후 DSN 입력. NEXT_PUBLIC_ 접두사는 클라이언트 노출(브라우저 전송)에 필요.
NEXT_PUBLIC_SENTRY_DSN=
# 릴리즈 태깅(선택). 미설정 시 태깅 생략. CI/로컬에서 git commit SHA 등을 주입.
#   서버/Edge 런타임용:
SENTRY_RELEASE=
#   클라이언트 번들용(빌드 타임 인라인):
NEXT_PUBLIC_SENTRY_RELEASE=
# 소스맵 업로드용(빌드 타임 서버 전용, 클라이언트 노출 금지). 셋 다 있을 때만 업로드 수행.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# 모바일(Expo) — EXPO_PUBLIC_ 접두사는 앱 번들에 인라인되어 런타임에서 읽힌다.
# 릴리즈/dist는 @sentry/react-native/expo 플러그인이 app version+build에서 자동 태깅.
EXPO_PUBLIC_SENTRY_DSN=
