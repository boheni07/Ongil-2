{
  "name": "ongil-platform",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @ongil/web dev",
    "dev:mobile": "pnpm --filter @ongil/mobile start",
    "build:web": "pnpm --filter @ongil/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:migrate": "prisma migrate dev --schema=supabase/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=supabase/prisma/schema.prisma"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "prisma": "^6.19.3",
    "supabase": "^2.109.1",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
